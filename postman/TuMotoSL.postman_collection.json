                "exec": [
                  "// Guarda el token recibido para usarlo en los próximos pedidos\r\nconst respuesta = pm.response.json();\r\n\r\nif (respuesta.token) {\r\n  pm.collectionVariables.set('token', respuesta.token);\r\n  console.log('Token guardado:', respuesta.token);\r\n}\r\n\r\npm.test('Devuelve un token', () => pm.expect(respuesta.token).to.be.a('string'));"
                ]
              }
            }
